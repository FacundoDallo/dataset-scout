<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>One-page summary | {{ question }}</title>
<style>
{% include "_styles.css.j2" %}

@page { size: A4; margin: 13mm 14mm; }
html { background: var(--wash); }
body { background: var(--wash); font-size: 13px; }
.sheet {
  width: 210mm;
  min-height: 297mm;
  margin: 1.5rem auto;
  padding: 13mm 14mm;
  background: var(--paper);
  border: 1px solid var(--rule);
}
.sheet > div { margin-bottom: 6mm; }
.top { border-bottom: 1px solid var(--rule); padding-bottom: 4mm; }
.top .tool { color: var(--muted); font-size: 0.82rem; margin-bottom: 2.5mm; }
.top h1 { font-size: 1.55rem; max-width: 34ch; margin-bottom: 2.5mm; }
.top .answer { font-size: 1.02rem; margin: 0; max-width: none; }
.two { display: table; width: 100%; table-layout: fixed; }
.two > div { display: table-cell; vertical-align: top; width: 50%; }
.two > div + div { padding-left: 7mm; }
h2 { font-size: 1.02rem; margin-bottom: 2mm; }
table.cascade td.label { width: 10rem; font-size: 0.8rem; }
table.cascade .track { height: 0.7rem; }
table.meters td.label { width: 13rem; font-size: 0.8rem; }
.findings { margin: 0; padding-left: 1rem; font-size: 0.86rem; }
.findings li { margin-bottom: 1.5mm; }
table.data { font-size: 0.78rem; }
table.data td, table.data th { padding: 0.28rem 0.35rem; }
.study-title { max-width: 40ch; }
.bottom { display: table; width: 100%; table-layout: fixed; border-top: 1px solid var(--rule); padding-top: 4mm; font-size: 0.78rem; }
.bottom > div { display: table-cell; vertical-align: top; padding-right: 6mm; }
.bottom p { margin: 0 0 1.5mm; }
.print-hint { max-width: 210mm; margin: 1rem auto 0; color: var(--muted); font-size: 0.85rem; }

@media print {
  html, body { background: var(--paper); }
  .sheet { margin: 0; border: 0; padding: 0; width: auto; min-height: auto; }
}
@media (max-width: 820px) {
  .sheet { width: auto; min-height: auto; margin: 0; padding: 1.25rem; }
  .two, .bottom, .two > div, .bottom > div { display: block; width: auto; padding-left: 0; }
}
</style>
</head>
<body>
<p class="print-hint no-print">To save as PDF: press Ctrl+P (Cmd+P on a Mac), choose "Save as PDF", and turn on background graphics.</p>
<main class="sheet">

  <div class="top">
    <p class="tool">Dataset Scout, one-page summary{% if author %} by {{ author }}{% endif %}. Built {{ lineage.finished_at[:10] }} from public GEO metadata.</p>
    <h1>{{ question }}</h1>
    <p class="answer">{{ headline }}</p>
  </div>

  <div class="two">
    <div>
      <h2>Screening cascade</h2>
      <table class="cascade">
    {% for step in cascade %}
    <tr>
      <td class="label">{{ step.label }}</td>
      <td><span class="track" aria-hidden="true"><span class="bar" style="width: {{ '%.1f' | format(step.width) }}%"></span></span></td>
      <td class="count">{{ step.count | num }}</td>
      <td class="dropped">{% if step.dropped %}&minus;{{ step.dropped | num }}{% endif %}</td>
    </tr>
    {% endfor %}
  </table>
    </div>
    <div>
      <h2>What the run found</h2>
      <ul class="findings">
        {% for finding in summary.findings[:4] %}
        <li>{{ finding }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div>
    <h2>{% if top_five_are_usable %}Top {{ top_five | length }} usable {{ plural(top_five | length, "study", "studies") }}{% else %}Best-scoring studies (none reaches the usable threshold){% endif %}</h2>
    <table class="data">
      <thead>
        <tr><th style="width: 38%">Study</th><th>Data</th><th class="num">Young</th><th class="num">Old</th><th>Sex</th><th class="num">Score</th><th>Tier</th><th>Watch out for</th></tr>
      </thead>
      <tbody>
        {% for row in top_five %}
        <tr>
          <td><span class="accession">{{ row.gse }}</span> <span class="study-title">{{ row.title }}</span></td>
          <td>{{ row.data_type }}</td>
          <td class="num">{{ row.n_young | num }}</td>
          <td class="num">{{ row.n_old | num }}</td>
          <td>{{ row.sexes or "not stated" }}</td>
          <td class="num">{{ '%.0f' | format(row.score or 0) }}</td>
          <td><span class="tier tier-{{ row.tier_class }}">{{ row.tier }}</span></td>
          <td class="flags">{% for flag in row.flag_list[:3] %}{{ flag.label }}{% if not loop.last %}, {% endif %}{% else %}nothing flagged{% endfor %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div>
    <h2>How complete the sample metadata is</h2>
    <table class="meters">
    {% for item in summary.completeness %}
    <tr>
      <td class="label">{{ item.label }}</td>
      <td><span class="track" aria-hidden="true"><span class="bar" style="width: {{ '%.1f' | format(100 * item.share) }}%"></span></span></td>
      <td class="value">{{ item.share | pct }}</td>
    </tr>
    {% endfor %}
  </table>
  </div>

  <div class="bottom">
    <div>
      <h3>Accuracy</h3>
      {% if validation_rows %}
      <p>Blind manual review of {{ validation.rows_reviewed | num }} samples.</p>
      {% for row in validation_rows %}
      <p>{{ row.label }}: <strong>{{ row.accuracy | pct }}</strong> <span class="muted">({{ row.ci_low | pct }}&ndash;{{ row.ci_high | pct }})</span></p>
      {% endfor %}
      {% else %}
      <p>Manual review pending. Agreement per field will appear here after <code>scout validate</code>.</p>
      {% endif %}
    </div>
    <div>
      <h3>Method</h3>
      <p>NCBI GEO search, then rule-based harmonization of free-text sample metadata into age, sex, tissue, cell type and strain, keeping the raw text and rule behind every value.</p>
      <p>Score = weighted completeness, design fit, data type and traceability. Weights live in a YAML file.</p>
      <p>{{ status_counts.pass }} of {{ checks | length }} automated checks passed{% if status_counts.fail %}; {{ status_counts.fail }} failed{% endif %}.</p>
    </div>
    <div>
      <h3>Reproducibility</h3>
      <p>Every NCBI response is stored, so the run replays offline with identical results.</p>
      <p>Run {{ lineage.run_id }}; configuration SHA-256 {{ lineage.config_sha256[:12] }}.</p>
      <p>Python, DuckDB, SQL views, pytest, GitHub Actions, Docker.</p>
      {% if project_url %}<p><a href="{{ project_url }}">{{ project_url }}</a></p>{% endif %}
    </div>
  </div>

</main>
</body>
</html>
