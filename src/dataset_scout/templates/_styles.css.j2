/* Palette taken from H&E staining: hematoxylin (blue-violet) marks what is
   ready, eosin (pink) marks what needs curation. Every colour is paired with
   a text label, so the report also reads correctly in black and white. */
:root {
  color-scheme: light;
  --paper: #ffffff;
  --wash: #f4f3f8;
  --ink: #221f33;
  --muted: #5d5a6e;
  --rule: #d9d6e3;
  --hema: #3f3a8c;
  --hema-soft: #e3e1f2;
  --eosin: #b8436e;
  --eosin-soft: #f5e1e9;
  --low: #8a879a;
  --low-soft: #ebeaf0;
  --serif: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
  --sans: "Segoe UI", "Helvetica Neue", Arial, system-ui, sans-serif;
}

* { box-sizing: border-box; }

html { background: var(--paper); }

body {
  margin: 0;
  color: var(--ink);
  background: var(--paper);
  font-family: var(--sans);
  font-size: 15px;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

a { color: var(--hema); text-underline-offset: 2px; }
a:focus-visible { outline: 2px solid var(--eosin); outline-offset: 2px; }

h1, h2, h3 { font-family: var(--serif); font-weight: 600; line-height: 1.2; margin: 0; }
h2 { font-size: 1.4rem; }
h3 { font-size: 1.05rem; }

p { margin: 0 0 0.75rem; max-width: 72ch; }

.muted { color: var(--muted); }
.small { font-size: 0.85rem; }

/* The screening cascade: how many studies survive each filter.
   Built as a table so it renders the same in browsers, e-mail and print. */
table.cascade, table.meters { border-collapse: collapse; width: 100%; }
table.cascade td, table.meters td { padding: 0.22rem 0; vertical-align: middle; }
table.cascade td.label, table.meters td.label { width: 16rem; padding-right: 0.9rem; font-size: 0.92rem; }
table.cascade td.count, table.meters td.value { width: 3.5rem; text-align: right; font-weight: 600; }
table.cascade td.dropped { width: 4rem; padding-left: 0.6rem; color: var(--muted); font-size: 0.8rem; }
.track { display: block; height: 0.9rem; background: var(--wash); }
.track .bar { display: block; height: 100%; background: var(--hema); }
table.cascade tr:last-child .bar { background: var(--eosin); }
table.meters { max-width: 42rem; }
table.meters .track { height: 0.55rem; }

table.data { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
table.data caption { text-align: left; color: var(--muted); font-size: 0.85rem; padding-bottom: 0.4rem; }
table.data th {
  text-align: left;
  font-weight: 600;
  color: var(--muted);
  border-bottom: 1.5px solid var(--ink);
  padding: 0.35rem 0.5rem;
  vertical-align: bottom;
}
table.data td { border-bottom: 1px solid var(--rule); padding: 0.45rem 0.5rem; vertical-align: top; }
table.data td.num, table.data th.num { text-align: right; white-space: nowrap; }
table.data tr { break-inside: avoid; }
.study-title { display: block; max-width: 46ch; }
.accession { font-weight: 600; white-space: nowrap; }

.tier { white-space: nowrap; }
.tier::before {
  content: "";
  display: inline-block;
  width: 0.62em;
  height: 0.62em;
  margin-right: 0.35em;
  vertical-align: 0.05em;
  background: var(--low);
}
.tier-ready::before { background: var(--hema); }
.tier-usable::before { background: var(--eosin); }

.score-num { display: inline-block; min-width: 2rem; text-align: right; }
.meter { display: inline-block; width: 3rem; height: 0.4rem; margin-left: 0.35rem; background: var(--wash); vertical-align: middle; }
.meter span { display: block; height: 100%; background: var(--ink); }

.flags { color: var(--muted); font-size: 0.82rem; }

.status { font-weight: 600; white-space: nowrap; }
.status-pass { color: var(--hema); }
.status-warn { color: var(--eosin); }
.status-fail { color: #9b1c1c; }

.note {
  border-left: 3px solid var(--eosin);
  background: var(--eosin-soft);
  padding: 0.6rem 0.9rem;
  margin: 0 0 1rem;
  max-width: 72ch;
}
.note.neutral { border-left-color: var(--hema); background: var(--hema-soft); }

code { font-family: Consolas, "SFMono-Regular", Menlo, monospace; font-size: 0.86em; background: var(--wash); padding: 0.05rem 0.3rem; }

dl.facts { margin: 0; font-size: 0.88rem; }
dl.facts dt { float: left; clear: left; width: 11rem; }
dl.facts dd { margin: 0 0 0.25rem 12rem; }
dl.facts dt { color: var(--muted); }
dl.facts dd { overflow-wrap: anywhere; }

@media (max-width: 720px) {
  table.cascade td.label, table.meters td.label { width: 9rem; }
  .table-scroll { overflow-x: auto; }
}

@media print {
  body { font-size: 9.5pt; }
  a { color: inherit; text-decoration: none; }
  .no-print { display: none !important; }
  .track, .track .bar, .meter, .meter span, .tier::before, .note {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
}
