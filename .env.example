# Copy this file to .env (same folder) and fill in your details.
# .env is ignored by Git, so these values never reach GitHub.

# NCBI asks every tool to identify itself with a contact e-mail.
NCBI_EMAIL=you@example.com

# Optional. Free key from your NCBI account settings; allows 10 requests per second instead of 3.
NCBI_API_KEY=
